# Copy to deploy/docker/.env. Never commit the real values.
# First installation only: after signing in, change credentials in Account & Security.
# Then remove both INFOOS_ADMIN_* values; an existing database ignores them.
INFOOS_ADMIN_USERNAME=
INFOOS_ADMIN_PASSWORD=

INFOOS_BIND_ADDRESS=127.0.0.1
INFOOS_HTTP_PORT=8443
# Container and volume names follow the Compose project (default: infoos).
# Override only to reuse an existing installation's names.
# INFOOS_CONTAINER_NAME=infoos
INFOOS_IMAGE=infoos-appliance:local
# INFOOS_STATE_VOLUME=infoos-state
# INFOOS_DATA_VOLUME=infoos-data

INFOOS_UID=1000
INFOOS_GID=1000
INFOOS_DISPLAY_WIDTH=1920
INFOOS_DISPLAY_HEIGHT=1080
INFOOS_SHM_SIZE=1gb
INFOOS_SCHEDULER_INTERVAL_SECONDS=900
INFOOS_MAX_ATTEMPTS=2
# Per-queue in-process concurrency. Keep GPU/maintenance serialized unless
# target-host measurements justify raising them.
INFOOS_PUBLIC_FETCH_WORKERS=4
INFOOS_BROWSER_FETCH_WORKERS=2
INFOOS_BROWSER_FETCH_BATCH_LIMIT=2
INFOOS_URGENT_MEDIA_WORKERS=4
INFOOS_CARD_PIPELINE_WORKERS=4
INFOOS_GPU_ASR_WORKERS=1
# Keep one process-isolated CUDA model resident across VIDEO_TRANSCRIBE tasks.
# Set to 0 only as a rollback to the per-task subprocess path.
INFOOS_FASTER_WHISPER_PERSISTENT_RUNTIME_ENABLED=1
INFOOS_MAINTENANCE_IO_WORKERS=1
# Cross-queue admission for audio extraction and GPU ASR.
# The task lease pool is shared through SQLite by urgent_media and gpu_asr.
INFOOS_MEDIA_COMPUTE_SLOTS=2
INFOOS_RESOURCE_PRESSURE_FULL_AVG10=1.0
INFOOS_RESOURCE_MIN_AVAILABLE_MIB=4096
# At 10 GiB (including page cache), stop admitting new media-compute work.
# Leave 2 GiB below the hard limit for running tasks; this is not an OOM guarantee.
INFOOS_MEMORY_SOFT_LIMIT_MIB=10240
# Reservation is a reclaim preference, not preallocated RAM or task admission.
INFOOS_MEMORY_RESERVATION=6g
INFOOS_MEMORY_LIMIT=12g
# Total RAM + swap: 14 GiB allows up to 2 GiB of swap when the host has swap.
INFOOS_MEMORY_SWAP_LIMIT=14g
# Successful VIDEO_TRANSCRIBE tasks keep their intermediate WAV for this many
# days. Set to 0 to disable deletion; the hourly maintenance queue deletes at
# most this many safe candidates per pass.
INFOOS_AUDIO_RETENTION_DAYS=7
INFOOS_AUDIO_RETENTION_BATCH=500
# TASK_EVENT_ARCHIVE retention and per-run budget.
INFOOS_TASK_EVENT_HOT_WINDOW_DAYS=30
INFOOS_TASK_EVENT_CRITICAL_HOT_WINDOW_DAYS=180
INFOOS_TASK_EVENT_ARCHIVE_BATCH_SIZE=2000
INFOOS_TASK_EVENT_ARCHIVE_MAX_ROWS=50000
INFOOS_TASK_EVENT_ARCHIVE_MAX_SECONDS=300
INFOOS_BROWSER_CONSOLE_IDLE_SECONDS=600
INFOOS_BROWSER_CONSOLE_MAX_SECONDS=1800
# Optional embedded Mihomo outbound gateway. Put the secret-bearing source
# Build with INFOOS_WITH_MIHOMO=1 before enabling the runtime switch.
# configuration at /var/lib/infoos/state/proxy/source.yaml in the state volume.
# When enabled, all five proxy URLs below must use the fixed loopback endpoint;
# startup fails closed instead of silently chaining to a host proxy.
INFOOS_EMBEDDED_PROXY_ENABLED=0
# Required values when INFOOS_EMBEDDED_PROXY_ENABLED=1:
# INFOOS_OUTBOUND_PROXY_URL=http://127.0.0.1:17897
# INFOOS_BROWSER_PROXY_URL=http://127.0.0.1:17897
INFOOS_OUTBOUND_PROXY_URL=
INFOOS_BROWSER_PROXY_URL=
INFOOS_NO_PROXY=127.0.0.1,localhost
# Optional read-only comparison provider for ordinary public Web capture.
# This never replaces the InfoOS HTTP result or writes provider content to cards.
# Keep disabled unless Wigolo runs on an isolated network reachable by the Appliance.
INFOOS_PUBLIC_DOCUMENT_SHADOW_PROVIDER=
INFOOS_WIGOLO_SHADOW_BASE_URL=
INFOOS_WIGOLO_SHADOW_TOKEN_FILE=/var/lib/infoos/state/providers/wigolo.token
INFOOS_WIGOLO_SHADOW_TIMEOUT_SECONDS=45
# Optional. Required for authentication-recovery email deep links.
# Must be an HTTPS origin without a path, query, fragment, or credentials.
# Example: https://infoos.example.com
INFOOS_PUBLIC_BASE_URL=
# Optional edge gateway shared secret, generated by the user; never commit it.
INFOOS_EDGE_READER_SECRET=

INFOOS_CHROME_VERSION=150.0.7871.114-1
INFOOS_CHROME_SHA256=0f19e68dca574849632e25229f15853d2beac33fa06498feed43f34628bc2d53
INFOOS_OPENCLI_VERSION=1.8.6
INFOOS_OPENCLI_EXTENSION_VERSION=1.0.22
INFOOS_OPENCLI_EXTENSION_SHA256=31e9e7238c68f83a76d30b3fbde2bb0d76106588bb070d3fc5be6576422b9990
INFOOS_MIHOMO_VERSION=1.19.29
INFOOS_WITH_MIHOMO=0
INFOOS_MIHOMO_SHA256=5612e698e96c8b8ad15abc4c0a4f098eba9234354b4f248cb97f2528e215b094
INFOOS_TORCH_CPU_VERSION=2.9.1+cpu
INFOOS_INSTALL_CUDA_ASR=0
# RTX/NVIDIA 主机请不要只把上一项改为 1；同时使用 compose.gpu.yaml，
# 让镜像依赖、GPU device request 与运行时开关保持同一个合同。
INFOOS_NVIDIA_VISIBLE_DEVICES=all
TZ=Asia/Shanghai
