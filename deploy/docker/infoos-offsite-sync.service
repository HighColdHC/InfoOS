[Unit]
Description=InfoOS offsite database snapshot sync
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
UMask=0077
EnvironmentFile=/etc/infoos/offsite.env
ExecStart=/usr/local/lib/infoos/infoos-offsite-sync
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
