#!/bin/sh
set -u

service_name="$1"
shift
history_file="/tmp/infoos-${service_name}-starts"
stopped_file="/tmp/infoos-${service_name}-stopped"
now="$(date +%s)"
window_start="$((now - 300))"

if [ -f "$history_file" ]; then
  awk -v cutoff="$window_start" '$1 >= cutoff' "$history_file" > "${history_file}.next"
  mv "${history_file}.next" "$history_file"
fi
printf '%s\n' "$now" >> "$history_file"
rm -f "$stopped_file"

# `setsid` forks when its caller is already a process-group leader.  Without
# `--wait`, the PID tracked below can therefore exit while the real service is
# still running as an orphan, which makes the container supervisor restart the
# service and race the orphan for its listening port.
setsid --wait "$@" &
child_pid="$!"

terminate() {
  touch /tmp/infoos-draining
  dependencies=""
  case "$service_name" in
    infoos-worker-*|infoos-feishu-inbox) dependencies="infoos-scheduler" ;;
    chrome)
      dependencies="infoos-worker-public-fetch infoos-worker-browser-fetch infoos-worker-urgent-media infoos-worker-card-pipeline infoos-worker-gpu-asr infoos-worker-maintenance-io infoos-worker-auth-qr-check infoos-feishu-inbox"
      ;;
    opencli) dependencies="chrome" ;;
    infoos-web) dependencies="opencli" ;;
    infoos-proxy) dependencies="infoos-web" ;;
  esac
  if [ -n "$dependencies" ]; then
    waited=0
    while [ "$waited" -lt 70 ]; do
      missing=""
      for dependency in $dependencies; do
        [ -f "/tmp/infoos-${dependency}-stopped" ] || missing="${missing} ${dependency}"
      done
      [ -n "$missing" ] || break
      sleep 1
      waited="$((waited + 1))"
    done
  fi
  for dependency in $dependencies; do
    if [ ! -f "/tmp/infoos-${dependency}-stopped" ]; then
      echo "[infoos-lifecycle] service=${service_name} action=dependency_timeout dependency=${dependency}"
    fi
  done
  echo "[infoos-lifecycle] service=${service_name} action=terminate dependencies=${dependencies:-none}"
  kill -TERM "-$child_pid" 2>/dev/null || true
  wait "$child_pid" 2>/dev/null || true
  touch "$stopped_file"
  echo "[infoos-lifecycle] service=${service_name} action=stopped"
  exit 0
}

trap terminate TERM INT
wait "$child_pid"
exit "$?"
