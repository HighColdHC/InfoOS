# Standalone nginx configuration. Replace example.com and ALL_CAPS placeholders.
# Edge nginx and Authelia run on this host; Appliance HTTPS is loopback-only.
worker_processes auto;
events { worker_connections 1024; }
http {
    map $http_upgrade $infoos_connection {
        default upgrade;
        '' close;
    }
    # Strip only the configured Authelia cookie, retaining application sessions
    # and the Browser Console grant. Keep the cookie name in configuration.yml.
    map $http_cookie $infoos_cookie_tail {
        default $http_cookie;
        "~^authelia_session=[^;]*;?\s*(?<infoos_tail>.*)$" $infoos_tail;
    }
    map $infoos_cookie_tail $infoos_cookies {
        default $infoos_cookie_tail;
        "~^(?<infoos_before>.*);\s*authelia_session=[^;]*(?<infoos_after>.*)$" "$infoos_before$infoos_after";
    }
    server {
        listen 443 ssl;
        server_name auth.example.com;
        ssl_certificate /etc/nginx/tls/edge-fullchain.pem;
        ssl_certificate_key /etc/nginx/tls/edge-key.pem;
        location / {
            proxy_pass http://127.0.0.1:9091;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header Connection "";
        }
    }
    server {
        listen 443 ssl;
        server_name infoos.example.com;
        ssl_certificate /etc/nginx/tls/edge-fullchain.pem;
        ssl_certificate_key /etc/nginx/tls/edge-key.pem;
        client_max_body_size 64m;
        # Local, restricted file: set $infoos_edge_secret "USER_GENERATED_SECRET";
        # No secret or usable default is shipped in this repository.
        include /etc/nginx/infoos-edge-secret.conf;

        location = /internal/authelia/authz {
            internal;
            proxy_pass http://127.0.0.1:9091/api/authz/auth-request;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header Connection "";
            proxy_set_header X-Original-Method $request_method;
            proxy_set_header X-Original-URL https://$host$request_uri;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header Cookie $http_cookie;
            proxy_set_header Authorization "";
        }
        location ^~ /api/internal/ { return 404; }
        location ~ ^/_infoos_ { return 404; }
        location = /api/internal { return 404; }

        # Machine APIs: no Authelia challenge, no edge credential, Bearer intact.
        location ~ ^/(?:mcp(?:/|$)|api/plugin/v1(?:/|$)|api/capture/v1/) {
            include /etc/nginx/infoos-edge/proxy-common.conf;
            proxy_set_header X-InfoOS-Edge-Auth "";
            proxy_set_header Authorization $http_authorization;
            proxy_set_header Cookie "";
            proxy_set_header Connection "";
            proxy_pass https://127.0.0.1:8443;
        }
        # All other paths/methods: management, Console (including WS), readers,
        # previews and attachments. The backend still checks Console grants.
        location / {
            if ($infoos_edge_secret = "") { return 503; }
            auth_request /internal/authelia/authz;
            auth_request_set $infoos_login_url $upstream_http_location;
            error_page 401 =302 $infoos_login_url;
            include /etc/nginx/infoos-edge/proxy-common.conf;
            proxy_set_header X-InfoOS-Edge-Auth $infoos_edge_secret;
            proxy_set_header Authorization "";
            proxy_set_header Cookie $infoos_cookies;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $infoos_connection;
            proxy_pass https://127.0.0.1:8443;
        }
    }
}
