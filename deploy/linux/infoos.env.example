# Non-secret Linux runtime contract. Copy to /etc/infoos/infoos.env and keep
# credentials in that root-owned file or protected state config, never in Git.
HOME=/var/lib/infoos/state
INFOOS_STATE_HOME=/var/lib/infoos/state
INFOOS_DATA_HOME=/var/lib/infoos/data
INFOOS_CONFIG_PATH=/var/lib/infoos/state/config.yaml
INFOOS_CHROME_PROFILE_DIR=/var/lib/infoos/state/chrome-profile
INFOOS_CHROME_BIN=/usr/bin/google-chrome-stable
INFOOS_BROWSER_LAUNCHER=/opt/infoos/app/scripts/opencli-infoos-chrome
INFOOS_BROWSER_BINDING_HELPER=/opt/infoos/app/scripts/infoos-browser-binding.py
INFOOS_PYTHON_EXECUTABLE=/opt/infoos/app/.venv/bin/python
INFOOS_OPENCLI_EXECUTABLE=/var/lib/infoos/state/runtime/opencli/node_modules/.bin/opencli
INFOOS_OPENCLI_LOG_DIR=/var/lib/infoos/state/logs/opencli
# Optional local GPU path. This accelerates VIDEO_TRANSCRIBE only; card
# translation and AI interpretation continue to use the source-bound cloud LLM.
INFOOS_FASTER_WHISPER_CUDA_ENABLED=0
INFOOS_FASTER_WHISPER_DOWNLOAD_ROOT=/var/lib/infoos/state/models/faster-whisper
INFOOS_FASTER_WHISPER_TIMEOUT_SECONDS=3600
INFOOS_FASTER_WHISPER_PERSISTENT_RUNTIME_ENABLED=1
INFOOS_GPU_LOCK_PATH=/var/lib/infoos/state/gpu.lock
INFOOS_GPU_LOCK_TIMEOUT_SECONDS=1800
INFOOS_WEB_HOST=127.0.0.1
INFOOS_WEB_PORT=8000
PYTHONUNBUFFERED=1
